package pages

import (
	"saui/locale"
	"saui/templates/layout"
	"saui/templates/partials"
)

templ Code(csrfToken string, lang locale.Lang) {
	@layout.Base(
		lang.T("Code", "Código"),
		lang.T(
			"The SAUI reference implementation in Go. Read the source, understand the architecture, and apply the pattern to your own projects.",
			"La implementación de referencia de SAUI en Go. Lee el código fuente, comprende la arquitectura y aplica el patrón a tus propios proyectos.",
		),
		csrfToken,
		lang.Prefix()+"/code",
		"/static/css/code.css",
		lang,
	) {
		<section class="page-hero page-hero--split">
			<div class="page-hero__content">
				<h1>{ lang.T("Code", "Código") }</h1>
				<p class="lead">{ lang.T("The reference implementation. This site is the reference implementation.", "La implementación de referencia. Este sitio es la implementación de referencia.") }</p>
			</div>
			<div class="page-hero__figure">
				<svg class="hero-gfx" viewBox="0 0 480 400" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
					<rect class="hg-fill" x="90" y="70" width="300" height="196" rx="10"></rect>
					<line class="hg-edge" x1="90" y1="98" x2="390" y2="98"></line>
					<circle class="hg-node" cx="108" cy="84" r="3.5"></circle>
					<circle class="hg-node" cx="122" cy="84" r="3.5"></circle>
					<circle class="hg-node" cx="136" cy="84" r="3.5"></circle>
					<text class="hg-label hg-label--dim" x="372" y="88" text-anchor="end">gateway.go</text>
					<line class="hg-stroke" x1="112" y1="128" x2="188" y2="128"></line>
					<line class="hg-stroke" x1="196" y1="128" x2="264" y2="128"></line>
					<line class="hg-stroke" x1="132" y1="154" x2="208" y2="154"></line>
					<line class="hg-stroke" x1="216" y1="154" x2="300" y2="154"></line>
					<line class="hg-stroke" x1="152" y1="180" x2="212" y2="180"></line>
					<line class="hg-stroke" x1="132" y1="206" x2="228" y2="206"></line>
					<line class="hg-stroke" x1="236" y1="206" x2="288" y2="206"></line>
					<rect class="hg-caret" x="296" y="196" width="7" height="16"></rect>
					<line class="hg-stroke" x1="112" y1="232" x2="150" y2="232"></line>
					<line class="hg-edge" x1="120" y1="308" x2="360" y2="308"></line>
					<circle class="hg-node" cx="120" cy="308" r="6"></circle>
					<circle class="hg-core" cx="180" cy="308" r="6"></circle>
					<circle class="hg-node" cx="240" cy="308" r="6"></circle>
					<circle class="hg-core" cx="300" cy="308" r="6"></circle>
					<circle class="hg-node" cx="360" cy="308" r="6"></circle>
					<text class="hg-label hg-label--dim" x="240" y="346" text-anchor="middle">open source · auditable</text>
				</svg>
			</div>
		</section>
		<article>
			<section>
				<h2>{ lang.T("This site", "Este sitio") }</h2>
				<p>{ lang.T(
					"SAUI.dev is built on the stack it documents. The source is available on GitHub. Every architectural claim made on this site is demonstrated by the codebase that serves it.",
					"SAUI.dev está construido sobre la pila que documenta. El código fuente está disponible en GitHub. Cada afirmación arquitectónica hecha en este sitio está demostrada por el código base que lo sirve.",
				) }</p>
				<p>
					<a href="https://github.com/your-org/saui" rel="noopener noreferrer" target="_blank">
						{ lang.T("View source on GitHub", "Ver código fuente en GitHub") }
					</a>
				</p>
			</section>
			<section>
				<h2>{ lang.T("Stack", "Tecnología") }</h2>
				<ul>
					<li>{ lang.T("Go 1.22+ with standard library only for HTTP and templates", "Go 1.22+ con solo biblioteca estándar para HTTP y plantillas") }</li>
					<li>{ lang.T("modernc.org/sqlite: pure Go SQLite, no cgo", "modernc.org/sqlite: SQLite en Go puro, sin cgo") }</li>
					<li>{ lang.T("github.com/a-h/templ: type-safe HTML templates", "github.com/a-h/templ: plantillas HTML con seguridad de tipos") }</li>
					<li>{ lang.T("htmx 2.0: partial DOM updates", "htmx 2.0: actualizaciones parciales del DOM") }</li>
					<li>{ lang.T("Vanilla CSS and JS: no build step", "CSS y JS vanilla: sin paso de compilación") }</li>
					<li>{ lang.T("Fly.io: single binary deployment", "Fly.io: despliegue de binario único") }</li>
				</ul>
			</section>
			<section>
				<h2>{ lang.T("Running locally", "Ejecutar localmente") }</h2>
				<pre><code>{ `git clone https://github.com/your-org/saui
cd saui
templ generate
go run .
# open http://localhost:8080` }</code></pre>
			</section>
			<section id="feedback" aria-label={ lang.T("Feedback", "Retroalimentación") }>
				<h2>{ lang.T("What do you think?", "¿Qué opinas?") }</h2>
				<p>{ lang.T(
					"Counterarguments, edge cases, and alternative approaches are welcome. This is an architectural argument, not a product page. Push back.",
					"Los contraargumentos, casos límite y enfoques alternativos son bienvenidos. Este es un argumento arquitectónico, no una página de producto. Empuja hacia atrás.",
				) }</p>
				@partials.FeedbackForm(csrfToken, "", "", 3)
			</section>
		</article>
	}
}
