package pages

import "saui/templates/layout"

templ CaseSaaS(csrfToken string) {
	@layout.Base("Case Study: SaaS Dashboards", "SAUI for multi-tenant SaaS: server-authoritative state eliminates cross-tenant state leaks and removes client-side synchronisation complexity.", csrfToken, "/cases/saas-dashboard", "/static/css/cases-saas.css") {
		<section class="page-hero">
			<div class="page-hero__content">
				<nav class="page-hero__breadcrumb" aria-label="Breadcrumb">
					<a href="/cases">{ `Case Studies` }</a>{ ` / SaaS Dashboards` }
				</nav>
				<h1>SaaS dashboards</h1>
				<p class="lead">{ `Filter state, bulk actions, and unsaved edits are where SPA complexity accumulates fastest. SAUI simplifies each.` }</p>
			</div>
		</section>
		<article>
			<section>
				<h2>The client-side state model</h2>
				<p>{ `SaaS dashboards are among the most complex SPA deployments. They accumulate:` }</p>
				<ul>
					<li>{ `Filter and sort state: managed client-side, sometimes synced to URL, sometimes not` }</li>
					<li>{ `Pagination state: page number, page size, cursor; held in multiple places` }</li>
					<li>{ `Bulk selection state: which rows are checked, across pages` }</li>
					<li>{ `Unsaved edits: inline editing that has not been submitted` }</li>
					<li>{ `Real-time updates: new records appearing while the user is on page 3 of results` }</li>
				</ul>
				<p>{ `Each of these is a synchronisation problem. Each requires its own state management
					solution. Together, they produce dashboards that are fragile, slow to build,
					and expensive to maintain.` }</p>
			</section>
			<section>
				<h2>What moves to the server under SAUI</h2>
				<ul>
					<li>{ `Filter and sort state: encoded in the URL, applied server-side, returned as a projection` }</li>
					<li>{ `Pagination: server computes the page; cursor is opaque to the client` }</li>
					<li>{ `Bulk action validation: the gateway validates each selected record before applying the bulk action` }</li>
					<li>{ `Real-time updates: SSE pushes updated projections; the client swaps the target element` }</li>
				</ul>
				<p>{ `Filter state in the URL is bookmarkable, shareable, and survives reload without
					any client-side state management. The server applies the filters and returns
					the correct projection.` }</p>
			</section>
			<section>
				<h2>What stays on the client</h2>
				<ul>
					<li>{ `Dropdown open/close state for filter controls` }</li>
					<li>{ `Row hover highlight` }</li>
					<li>{ `Column resize drag state (ephemeral, not persisted)` }</li>
				</ul>
				<p>{ `Unsaved inline edits are a genuine case for ephemeral client state: the user is
					mid-edit and the UI should not submit until they confirm. This is legitimate UI-only
					state. It has no business meaning until submission, at which point it becomes an action.` }</p>
			</section>
			<section>
				<h2>Bulk actions</h2>
				<p>{ `Bulk actions are a common source of correctness problems in SPAs. The client holds
					a selection set. The user triggers a bulk delete. The client sends a list of IDs.
					Between selection and submission, some records may have changed state: already
					deleted by another user, locked by a process, no longer accessible.` }</p>
				<p>{ `Under SAUI, the gateway validates each record in the bulk action set before
					appending any events. If any record fails validation, the entire action is rejected
					with the current state. No partial application. The client receives a projection
					of what actually happened.` }</p>
				<p><a href="/cases/distributed-systems">Next: Distributed systems</a></p>
			</section>
		</article>
	}
}
