package pages

import "saui/templates/layout"

templ Architecture(csrfToken string) {
	@layout.Base("Architecture", csrfToken, "/architecture") {
		<section class="arch-hero">
			<div class="arch-hero__content">
				<p class="arch-hero__eyebrow">{ `SAUI · Request Lifecycle` }</p>
				<h1>Architecture</h1>
				<p class="lead">{ `The server owns state. The gateway enforces that contract.
					The frontend submits intents, not state.` }</p>
			</div>
			<span class="arch-hero__scroll" aria-hidden="true">↓</span>
		</section>
		<section class="arch-diagram-section" aria-label="Request lifecycle diagram">
			<figure class="arch-diagram">
				<svg viewBox="0 0 780 620" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
					<defs>
						<marker id="dia-arrow" markerWidth="10" markerHeight="8" refX="10" refY="4" orient="auto">
							<polygon points="0 0, 10 4, 0 8" class="dia-arrowhead"/>
						</marker>
					</defs>
					<!-- Node 1: Browser (request) -->
					<g class="dia-node dia-node--browser">
						<rect x="260" y="12" width="260" height="80" rx="6"/>
						<text class="dia-node__title" x="390" y="44">Browser</text>
						<text class="dia-node__sub" x="390" y="68">{ `submits intent` }</text>
					</g>
					<!-- Annotation: right of Node 1 -->
					<g class="dia-annot dia-annot--n1">
						<line class="dia-annot__tick" x1="520" y1="52" x2="542" y2="52"/>
						<text class="dia-annot__label" x="548" y="46">{ `User submits intent` }</text>
						<text class="dia-annot__body" x="548" y="63">{ `form POST · htmx · full-page` }</text>
					</g>
					<!-- Arrow 1 -->
					<line class="dia-line dia-line--1" x1="390" y1="92" x2="390" y2="180" marker-end="url(#dia-arrow)"/>
					<text class="dia-line__label" x="398" y="141">{ `POST intent` }</text>
					<!-- Node 2: Gateway -->
					<g class="dia-node dia-node--gateway">
						<rect x="260" y="184" width="260" height="80" rx="6"/>
						<text class="dia-node__title dia-node__title--light" x="390" y="216">Gateway</text>
						<text class="dia-node__sub dia-node__sub--light" x="390" y="240">{ `auth · validate · apply` }</text>
					</g>
					<!-- Annotation: left of Node 2 -->
					<g class="dia-annot dia-annot--n2">
						<line class="dia-annot__tick" x1="260" y1="224" x2="238" y2="224"/>
						<text class="dia-annot__label dia-annot__label--end" x="232" y="218">{ `Authenticate · Authorize` }</text>
						<text class="dia-annot__body dia-annot__body--end" x="232" y="235">{ `validate · rate-limit · log` }</text>
					</g>
					<!-- Arrow 2 -->
					<line class="dia-line dia-line--2" x1="390" y1="264" x2="390" y2="352" marker-end="url(#dia-arrow)"/>
					<text class="dia-line__label" x="398" y="313">{ `append event` }</text>
					<!-- Node 3: Event Log -->
					<g class="dia-node dia-node--store">
						<rect x="260" y="356" width="260" height="80" rx="6"/>
						<text class="dia-node__title" x="390" y="388">{ `Event Log` }</text>
						<text class="dia-node__sub" x="390" y="412">{ `SQLite · append-only` }</text>
					</g>
					<!-- Annotation: right of Node 3 -->
					<g class="dia-annot dia-annot--n3">
						<line class="dia-annot__tick" x1="520" y1="396" x2="542" y2="396"/>
						<text class="dia-annot__label" x="548" y="390">{ `Append-only event log` }</text>
						<text class="dia-annot__body" x="548" y="407">{ `never mutated · auditable` }</text>
					</g>
					<!-- Arrow 3 -->
					<line class="dia-line dia-line--3" x1="390" y1="436" x2="390" y2="524" marker-end="url(#dia-arrow)"/>
					<text class="dia-line__label" x="398" y="485">{ `HTML projection` }</text>
					<!-- Node 4: Browser (response) -->
					<g class="dia-node dia-node--browser">
						<rect x="260" y="528" width="260" height="80" rx="6"/>
						<text class="dia-node__title" x="390" y="560">Browser</text>
						<text class="dia-node__sub" x="390" y="584">{ `renders truth` }</text>
					</g>
					<!-- Annotation: left of Node 4 -->
					<g class="dia-annot dia-annot--n4">
						<line class="dia-annot__tick" x1="260" y1="568" x2="238" y2="568"/>
						<text class="dia-annot__label dia-annot__label--end" x="232" y="562">{ `Server-projected HTML` }</text>
						<text class="dia-annot__body dia-annot__body--end" x="232" y="579">{ `durable truth rendered` }</text>
					</g>
				</svg>
				<figcaption>{ `The SAUI request lifecycle: intent in, projection out. State lives in one place.` }</figcaption>
			</figure>
		</section>
		<article>
			<section aria-label="Two-layer state model">
				<h2>The two-layer state model</h2>
				<p>{ `SAUI separates state into two distinct layers with different lifetimes, different
					storage, and a strict rule about which layer may influence the other.` }</p>
				<div class="state-comparison">
					<div class="state-layer state-layer--durable">
						<h3>Durable state</h3>
						<p class="state-layer__sub">{ `what actually happened` }</p>
						<ul>
							<li>{ `Stored as an append-only event log in SQLite` }</li>
							<li>{ `Never mutated; only appended` }</li>
							<li>{ `Survives server restart` }</li>
							<li>{ `Auditable by definition: the log is the audit trail` }</li>
							<li>{ `Source of truth for all projections` }</li>
						</ul>
					</div>
					<div class="state-layer state-layer--ephemeral">
						<h3>Ephemeral state</h3>
						<p class="state-layer__sub">{ `current session context` }</p>
						<ul>
							<li>{ `In-memory only, keyed by session ID` }</li>
							<li>{ `Holds UI context: current page, in-progress flows, flash messages` }</li>
							<li>{ `Derived from durable state on session creation` }</li>
							<li>{ `Never used as input to durable state transitions` }</li>
							<li>{ `Discarded on session end; no persistence required` }</li>
						</ul>
					</div>
				</div>
				<p>{ `The critical rule: ephemeral state flows one direction only. Durable state can
					seed ephemeral state. Ephemeral state never influences durable state transitions.` }</p>
			</section>
			<section aria-label="Gateway contract">
				<h2>The gateway contract</h2>
				<p>{ `All state access, read or write, passes through a single gateway. No handler,
					no middleware, no other package reads or writes state directly. This is enforced
					structurally: the Store type is unexported from the statestore package;
					only the Gateway is exposed.` }</p>
				<pre><code>{ `// Reading state - returns a named projection
gateway.Project(ctx, sessionID, "projection-name")

// Writing state - submits a validated intent
gateway.Dispatch(ctx, sessionID, action)` }</code></pre>
				<p>{ `The gateway enforces on every call:` }</p>
				<ul>
					<li>{ `Authentication context is valid` }</li>
					<li>{ `Actor has permission for this action or projection` }</li>
					<li>{ `Action validates against current state before application` }</li>
					<li>{ `Every state transition is logged` }</li>
				</ul>
			</section>
			<section aria-label="Action pattern">
				<h2>The action pattern</h2>
				<p>{ `State changes are expressed as validated intents, not direct mutations.
					A handler never writes state directly; it submits an action to the gateway.` }</p>
				<pre><code>{ `type Action interface {
    Type()     string
    Validate(ctx, store, sessionID) error
    Apply(ctx, store, sessionID)    (Event, error)
}` }</code></pre>
				<p>{ `The lifecycle of a state change:` }</p>
				<ol>
					<li>{ `Handler parses the request and constructs an action` }</li>
					<li>{ `Gateway calls Validate against current state; rejects if invalid` }</li>
					<li>{ `Gateway calls Apply; produces a new event` }</li>
					<li>{ `Event is appended to the durable log` }</li>
					<li>{ `Gateway returns the updated projection to the handler` }</li>
					<li>{ `Handler renders the projection as HTML: partial for htmx, full page otherwise` }</li>
				</ol>
				<blockquote class="callout">
					<p>{ `No partial application. No silent failure. No client state to reconcile.` }</p>
				</blockquote>
			</section>
			<section aria-label="Progressive enhancement">
				<h2>Progressive enhancement</h2>
				<p>{ `Every feature is built across four degradation levels. All four must produce
					correct state; the server owns truth regardless of client capability.` }</p>
				<dl class="pe-levels">
					<div class="pe-level">
						<dt><span class="pe-level__badge">L0</span>{ `No JS, no CSS` }</dt>
						<dd>{ `Native HTML forms, POST submission, PRG pattern. Must always work.` }</dd>
					</div>
					<div class="pe-level">
						<dt><span class="pe-level__badge">L1</span>{ `CSS only` }</dt>
						<dd>{ `Full layout applied. No visual state that depends on JS class toggling.` }</dd>
					</div>
					<div class="pe-level">
						<dt><span class="pe-level__badge">L2</span>{ `JS present, htmx not yet loaded` }</dt>
						<dd>{ `Native form submission holds. Full page responses.` }</dd>
					</div>
					<div class="pe-level">
						<dt><span class="pe-level__badge">L3</span>{ `htmx loaded` }</dt>
						<dd>{ `Partial DOM updates active. Forms intercepted. hx-boost on navigation.` }</dd>
					</div>
					<div class="pe-level">
						<dt><span class="pe-level__badge">L4</span>{ `Full baseline JS` }</dt>
						<dd>{ `SSE connection for real-time projection updates. View Transitions if supported.` }</dd>
					</div>
				</dl>
				<p><a href="/stack">{ `See the Go implementation` }</a></p>
			</section>
		</article>
	}
}
