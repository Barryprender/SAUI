package pages

import "saui/templates/layout"

templ CaseMFE(csrfToken string) {
	@layout.Base("Case Study: Micro Frontends", "SAUI and micro-frontends: server-authoritative state unifies independently deployed frontend modules without cross-team state sharing protocols.", csrfToken, "/cases/micro-frontends", "/static/css/cases-mfe.css") {
		<section class="page-hero">
			<div class="page-hero__content">
				<nav class="page-hero__breadcrumb" aria-label="Breadcrumb">
					<a href="/cases">{ `Case Studies` }</a>{ ` / Micro Frontends` }
				</nav>
				<h1>Micro frontends</h1>
				<p class="lead">{ `Micro frontends under SAUI are genuinely independent because there is no shared client state to couple them.` }</p>
			</div>
		</section>
		<article>
			<section>
				<h2>The coupling problem in micro frontends</h2>
				<p>{ `The micro frontend pattern promises team independence: each team owns a vertical
					slice of the UI and deploys it independently. In practice, this independence is
					undermined by shared client-side state.` }</p>
				<p>{ `If MFE A and MFE B both need to know the current user cart, they must either
					share a state store (coupling) or duplicate state (staleness). Cross-MFE event
					buses, shared stores, and global state contracts emerge as the coordination mechanism.
					The teams are not independent; they are coupled through the state bus.` }</p>
			</section>
			<section>
				<h2>SAUI eliminates the coupling</h2>
				<p>{ `Under SAUI, there is no client-side state to share. Each MFE consumes its own
					projection from the server. The server is the source of truth. MFEs do not need
					to communicate with each other because they each have a direct line to the
					authoritative state.` }</p>
				<p>{ `If MFE A updates cart state by submitting an AddToCart action, the server appends
					the event and updates the cart projection. MFE B next render (or SSE update)
					reflects the current cart. No event bus. No shared store. No cross-MFE contract.` }</p>
			</section>
			<section>
				<h2>Team isolation in practice</h2>
				<ul>
					<li>{ `Each team owns a projection: their read model from the server` }</li>
					<li>{ `Each team owns their actions: their write interface to the gateway` }</li>
					<li>{ `Teams deploy independently: no shared build output` }</li>
					<li>{ `Teams test independently: no cross-MFE integration test surface` }</li>
				</ul>
				<p>{ `The seam between teams is the projection contract and the action API, both of
					which are server-defined. Changes to one team UI do not affect other teams.
					Changes to one team projection require coordination with the backend, but not
					with other frontend teams.` }</p>
			</section>
			<section>
				<h2>Composition</h2>
				<p>{ `MFEs under SAUI are composed server-side: each team template fragment is
					included in the page layout by the server. There is no client-side module
					federation, no runtime JS composition, no shared bundle negotiation.` }</p>
				<p>{ `Each fragment is a server-rendered HTML partial, served by the team own
					backend, composed into the page at the BFF or reverse proxy layer. The client
					receives assembled HTML. This is simpler, faster, and more resilient than
					client-side composition.` }</p>
				<p><a href="/cases">Back to all case studies</a></p>
			</section>
		</article>
	}
}
