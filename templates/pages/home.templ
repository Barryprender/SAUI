package pages

import "saui/templates/layout"

templ Home(csrfToken string) {
	@layout.Base("Server-Authoritative UI", csrfToken, "/", "/static/css/home.css") {
		<article class="home-hero">
			<section class="hero">
				<svg class="hero-bg" viewBox="0 0 1200 600" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
					<g class="hero-lines">
						<line x1="600" y1="300" x2="420" y2="185"/>
						<line x1="600" y1="300" x2="470" y2="405"/>
						<line x1="600" y1="300" x2="530" y2="130"/>
						<line x1="600" y1="300" x2="680" y2="420"/>
						<line x1="600" y1="300" x2="790" y2="200"/>
						<line x1="600" y1="300" x2="750" y2="350"/>
						<line x1="420" y1="185" x2="230" y2="100"/>
						<line x1="420" y1="185" x2="150" y2="310"/>
						<line x1="470" y1="405" x2="260" y2="470"/>
						<line x1="470" y1="405" x2="520" y2="520"/>
						<line x1="530" y1="130" x2="620" y2="60"/>
						<line x1="530" y1="130" x2="380" y2="50"/>
						<line x1="680" y1="420" x2="750" y2="530"/>
						<line x1="680" y1="420" x2="900" y2="450"/>
						<line x1="790" y1="200" x2="980" y2="140"/>
						<line x1="790" y1="200" x2="1010" y2="270"/>
						<line x1="750" y1="350" x2="970" y2="390"/>
						<line x1="750" y1="350" x2="1010" y2="270"/>
						<line x1="230" y1="100" x2="280" y2="50"/>
						<line x1="150" y1="310" x2="90" y2="200"/>
						<line x1="980" y1="140" x2="1100" y2="190"/>
						<line x1="900" y1="450" x2="1050" y2="490"/>
						<line x1="260" y1="470" x2="310" y2="545"/>
						<line x1="100" y1="450" x2="150" y2="310"/>
					</g>
					<g class="hero-nodes">
						<circle cx="230" cy="100" r="4"/>
						<circle cx="280" cy="50" r="3.5"/>
						<circle cx="380" cy="50" r="3"/>
						<circle cx="90" cy="200" r="3.5"/>
						<circle cx="150" cy="310" r="4"/>
						<circle cx="100" cy="450" r="3"/>
						<circle cx="260" cy="470" r="4"/>
						<circle cx="310" cy="545" r="3"/>
						<circle cx="520" cy="520" r="3.5"/>
						<circle cx="620" cy="60" r="4"/>
						<circle cx="750" cy="530" r="3.5"/>
						<circle cx="900" cy="450" r="4"/>
						<circle cx="980" cy="140" r="3.5"/>
						<circle cx="1010" cy="270" r="4"/>
						<circle cx="970" cy="390" r="3"/>
						<circle cx="1100" cy="190" r="3.5"/>
						<circle cx="1050" cy="490" r="3"/>
						<circle cx="420" cy="185" r="5.5"/>
						<circle cx="470" cy="405" r="5.5"/>
						<circle cx="530" cy="130" r="5"/>
						<circle cx="680" cy="420" r="5.5"/>
						<circle cx="790" cy="200" r="5"/>
						<circle cx="750" cy="350" r="5.5"/>
					</g>
					<circle class="hero-server" cx="600" cy="300" r="11"/>
				</svg>
				<div class="hero__content">
					<h1>The server owns state. The browser renders truth.</h1>
					<p>{ `The server is the single source of truth. The browser is a stateless view of it.` }</p>
					<p>
						<a href="/why" class="btn">Why this matters</a>
						<a href="/architecture" class="btn btn--secondary">See the architecture</a>
					</p>
				</div>
			</section>
		</article>
		<section class="statement" aria-label="Core proposition">
			<div class="statement__bg" aria-hidden="true"></div>
			<div class="statement__content">
				<p class="statement__eyebrow">{ `Server-Authoritative UI` }</p>
				<p class="statement__quote">
					<span class="statement__line">{ `The server owns state.` }</span>
					<span class="statement__line statement__line--two">{ `The browser renders truth.` }</span>
				</p>
			</div>
		</section>
		<article class="home-body">
			<section class="proposition">
				<h2>A user interface that displays server state is always correct by definition.</h2>
				<p>{ `A user interface that maintains its own copy of state is always eventually wrong.` }</p>
				<p>{ `The synchronisation problem (keeping client state consistent with server state)
					has generated entire engineering disciplines: state management libraries,
					cache invalidation strategies, optimistic update patterns, hydration pipelines.` }</p>
				<p>{ `SAUI eliminates the synchronisation problem by eliminating the second copy of state.` }</p>
			</section>
			<section class="nav-cards nav-cards--toc">
				<h2>Explore</h2>
				<ul>
					<li>
						<a href="/why">
							<span class="nav-card__num" aria-hidden="true">01</span>
							<h3>Why</h3>
							<p>{ `The diagnosis. What the SPA era got right, and what it universalised by mistake.` }</p>
							<span class="nav-card__arrow" aria-hidden="true">↗</span>
						</a>
					</li>
					<li>
						<a href="/architecture">
							<span class="nav-card__num" aria-hidden="true">02</span>
							<h3>Architecture</h3>
							<p>{ `The gateway contract, the two-layer state model, the action pattern.` }</p>
							<span class="nav-card__arrow" aria-hidden="true">↗</span>
						</a>
					</li>
					<li>
						<a href="/stack">
							<span class="nav-card__num" aria-hidden="true">03</span>
							<h3>Stack</h3>
							<p>{ `Go, SQLite, htmx, and nothing else. The implementation in detail.` }</p>
							<span class="nav-card__arrow" aria-hidden="true">↗</span>
						</a>
					</li>
					<li>
						<a href="/limits">
							<span class="nav-card__num" aria-hidden="true">04</span>
							<h3>Limits</h3>
							<p>{ `Where SAUI is the wrong choice. Stated plainly.` }</p>
							<span class="nav-card__arrow" aria-hidden="true">↗</span>
						</a>
					</li>
				</ul>
			</section>
		</article>
	}
}
