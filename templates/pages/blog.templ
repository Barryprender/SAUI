package pages

import "saui/templates/layout"

templ Blog(csrfToken string) {
	@layout.Base("Blog", "The SAUI blog: writing on server-authoritative UI, web architecture, security, and the history of how the web got here.", csrfToken, "/blog", "/static/css/blog.css") {
		<section class="page-hero">
			<div class="page-hero__content">
				<h1>Blog</h1>
				<p class="lead">{ `Posts, counterarguments, and responses.` }</p>
			</div>
		</section>
		<article>
			<ol class="blog-listing">
				<li class="blog-listing__post">
					<a class="blog-listing__thumb" href="/blog/server-response-time" tabindex="-1" aria-hidden="true">
						<img
							src="/static/img/blog-server-response-time.jpg"
							alt=""
							width="320"
							height="180"
							loading="lazy"
							decoding="async"
						/>
					</a>
					<div class="blog-listing__body">
						<time class="blog-listing__date" datetime="2026-05-20">{ `20 May 2026` }</time>
						<h2><a href="/blog/server-response-time">{ `Server response time: twenty years of change` }</a></h2>
						<p>{ `The premise that justified client-side state was server latency. In 2026, the latency is gone. The premise is not.` }</p>
					</div>
				</li>
			</ol>
		</article>
	}
}
