package pages

import (
	"saui/locale"
	"saui/templates/layout"
)

templ Blog(csrfToken string, lang locale.Lang) {
	@layout.Base(
		lang.T("Blog", "Blog"),
		lang.T(
			"The SAUI blog: writing on server-authoritative UI, web architecture, security, and the history of how the web got here.",
			"El blog de SAUI: escritos sobre interfaz autorizada por el servidor, arquitectura web, seguridad e historia de cómo llegó la web hasta aquí.",
		),
		csrfToken,
		lang.Prefix()+"/blog",
		"/static/css/blog.css",
		lang,
	) {
		<section class="page-hero page-hero--split">
			<div class="page-hero__content">
				<h1>Blog</h1>
				<p class="lead">{ lang.T("Posts, counterarguments, and responses.", "Publicaciones, contraargumentos y respuestas.") }</p>
			</div>
			<div class="page-hero__figure">
				<svg class="hero-gfx" viewBox="0 0 480 400" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
					<rect class="hg-fill" x="90" y="86" width="300" height="76" rx="10"></rect>
					<rect class="hg-core" x="90" y="86" width="7" height="76" rx="3.5"></rect>
					<rect class="hg-fill" x="112" y="104" width="44" height="40" rx="5"></rect>
					<line class="hg-stroke" x1="176" y1="112" x2="356" y2="112"></line>
					<line class="hg-edge--accent" x1="176" y1="132" x2="300" y2="132"></line>
					<text class="hg-label hg-label--dim" x="176" y="156">2026 · post</text>
					<rect class="hg-fill" x="90" y="176" width="300" height="72" rx="10"></rect>
					<rect class="hg-fill" x="112" y="192" width="42" height="38" rx="5"></rect>
					<line class="hg-stroke" x1="174" y1="200" x2="356" y2="200"></line>
					<line class="hg-stroke" x1="174" y1="220" x2="300" y2="220"></line>
					<rect class="hg-fill" x="90" y="262" width="300" height="72" rx="10"></rect>
					<rect class="hg-fill" x="112" y="278" width="42" height="38" rx="5"></rect>
					<line class="hg-stroke" x1="174" y1="286" x2="340" y2="286"></line>
					<line class="hg-stroke" x1="174" y1="306" x2="288" y2="306"></line>
					<circle class="hg-node" cx="368" cy="124" r="4"></circle>
					<circle class="hg-node" cx="368" cy="212" r="4"></circle>
					<circle class="hg-node" cx="368" cy="298" r="4"></circle>
				</svg>
			</div>
		</section>
		<article>
			<ol class="blog-listing">
				<li class="blog-listing__post">
					<a class="blog-listing__thumb" href={ templ.URL(lang.Prefix() + "/blog/soc2-architecture") } tabindex="-1" aria-hidden="true">
						<img
							src="/static/img/blog-soc2-architecture.svg"
							alt=""
							width="320"
							height="180"
							loading="lazy"
							decoding="async"
						/>
					</a>
					<div class="blog-listing__body">
						<time class="blog-listing__date" datetime="2026-09-17">{ lang.T("17 September 2026", "17 de septiembre de 2026") }</time>
						<h2><a href={ templ.URL(lang.Prefix() + "/blog/soc2-architecture") }>{ lang.T("What SOC 2 asks for, and what an architecture can answer", "Lo que exige SOC 2 y lo que puede responder una arquitectura") }</a></h2>
						<p>{ lang.T(
							"No architecture makes an organisation SOC 2 compliant. What it decides is how expensive the evidence will be to produce — and three of the nine Common Criteria are settled by where application state lives.",
							"Ninguna arquitectura hace que una organización cumpla con SOC 2. Lo que sí decide es cuán cara será la producción de evidencias, y tres de los nueve Criterios Comunes se resuelven según dónde resida el estado de la aplicación.",
						) }</p>
					</div>
				</li>
				<li class="blog-listing__post">
					<a class="blog-listing__thumb" href={ templ.URL(lang.Prefix() + "/blog/append-only-erasure") } tabindex="-1" aria-hidden="true">
						<img
							src="/static/img/blog-append-only-erasure.svg"
							alt=""
							width="320"
							height="180"
							loading="lazy"
							decoding="async"
						/>
					</a>
					<div class="blog-listing__body">
						<time class="blog-listing__date" datetime="2026-09-10">{ lang.T("10 September 2026", "10 de septiembre de 2026") }</time>
						<h2><a href={ templ.URL(lang.Prefix() + "/blog/append-only-erasure") }>{ lang.T("The log that cannot forget", "El registro que no puede olvidar") }</a></h2>
						<p>{ lang.T(
							"An append-only event log is the strongest audit trail a web application can have, and it runs straight into the GDPR right to erasure. The tension is real. It is also smaller than it looks.",
							"Un registro de eventos de solo anexado es el mejor rastro de auditoría que puede tener una aplicación web, y choca de frente con el derecho de supresión del RGPD. La tensión es real. También es menor de lo que parece.",
						) }</p>
					</div>
				</li>
				<li class="blog-listing__post">
					<a class="blog-listing__thumb" href={ templ.URL(lang.Prefix() + "/blog/cra-clock") } tabindex="-1" aria-hidden="true">
						<img
							src="/static/img/blog-cra-clock.svg"
							alt=""
							width="320"
							height="180"
							loading="lazy"
							decoding="async"
						/>
					</a>
					<div class="blog-listing__body">
						<time class="blog-listing__date" datetime="2026-09-10">{ lang.T("10 September 2026", "10 de septiembre de 2026") }</time>
						<h2><a href={ templ.URL(lang.Prefix() + "/blog/cra-clock") }>{ lang.T("The clock starts at discovery", "El reloj empieza en el descubrimiento") }</a></h2>
						<p>{ lang.T(
							"From 11 September 2026 the Cyber Resilience Act gives manufacturers 24 hours to warn ENISA about an actively exploited vulnerability. Meeting that deadline is a question about where your application's state lives.",
							"Desde el 11 de septiembre de 2026, la Ley de Ciberresiliencia concede a los fabricantes 24 horas para alertar a ENISA sobre una vulnerabilidad explotada activamente. Cumplir ese plazo es una cuestión sobre dónde reside el estado de tu aplicación.",
						) }</p>
					</div>
				</li>
				<li class="blog-listing__post">
					<a class="blog-listing__thumb" href={ templ.URL(lang.Prefix() + "/blog/eu-compliance") } tabindex="-1" aria-hidden="true">
						<img
							src="/static/img/blog-eu-compliance.svg"
							alt=""
							width="320"
							height="180"
							loading="lazy"
							decoding="async"
						/>
					</a>
					<div class="blog-listing__body">
						<time class="blog-listing__date" datetime="2026-07-24">{ lang.T("24 July 2026", "24 de julio de 2026") }</time>
						<h2><a href={ templ.URL(lang.Prefix() + "/blog/eu-compliance") }>{ lang.T("Compliance by architecture: GDPR, NIS2, and the EU security baseline", "Cumplimiento por arquitectura: RGPD, NIS2 y el estándar de seguridad de la UE") }</a></h2>
						<p>{ lang.T(
							"The EU now regulates web application security through GDPR, NIS2, the Cyber Resilience Act, and DORA. Server-authoritative UI turns several of their requirements from paperwork into structural properties of the system.",
							"La UE ahora regula la seguridad de las aplicaciones web mediante el RGPD, NIS2, la Ley de Ciberresiliencia y DORA. La interfaz autorizada por el servidor convierte varios de sus requisitos, de trámites en propiedades estructurales del sistema.",
						) }</p>
					</div>
				</li>
				<li class="blog-listing__post">
					<a class="blog-listing__thumb" href={ templ.URL(lang.Prefix() + "/blog/supply-chain") } tabindex="-1" aria-hidden="true">
						<img
							src="/static/img/blog-supply-chain.svg"
							alt=""
							width="320"
							height="180"
							loading="lazy"
							decoding="async"
						/>
					</a>
					<div class="blog-listing__body">
						<time class="blog-listing__date" datetime="2026-06-02">{ lang.T("2 June 2026", "2 de junio de 2026") }</time>
						<h2><a href={ templ.URL(lang.Prefix() + "/blog/supply-chain") }>{ lang.T("The dependency you didn't write", "La dependencia que no escribiste") }</a></h2>
						<p>{ lang.T(
							"Supply chain attacks are not a vulnerability problem — they are an architectural one. How conservative, server-side approaches reduce exposure at the structural level.",
							"Los ataques a la cadena de suministro no son un problema de vulnerabilidades, sino arquitectónico. Cómo los enfoques conservadores del lado del servidor reducen la exposición a nivel estructural.",
						) }</p>
					</div>
				</li>
				<li class="blog-listing__post">
					<a class="blog-listing__thumb" href={ templ.URL(lang.Prefix() + "/blog/server-response-time") } tabindex="-1" aria-hidden="true">
						<img
							src="/static/img/blog-server-response-time.jpg"
							alt=""
							width="320"
							height="180"
							loading="lazy"
							decoding="async"
						/>
					</a>
					<div class="blog-listing__body">
						<time class="blog-listing__date" datetime="2026-05-20">{ lang.T("20 May 2026", "20 de mayo de 2026") }</time>
						<h2><a href={ templ.URL(lang.Prefix() + "/blog/server-response-time") }>{ lang.T("Server response time: twenty years of change", "Tiempo de respuesta del servidor: veinte años de cambios") }</a></h2>
						<p>{ lang.T(
							"The premise that justified client-side state was server latency. In 2026, the latency is gone. The premise is not.",
							"La premisa que justificó el estado en el cliente fue la latencia del servidor. En 2026, la latencia ha desaparecido. La premisa no.",
						) }</p>
					</div>
				</li>
			</ol>
		</article>
	}
}
