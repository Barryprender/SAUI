package pages

import "saui/templates/layout"

templ Blog(csrfToken string) {
	@layout.Base("Blog", csrfToken, "/blog", "/static/css/blog.css") {
		<section class="page-hero">
			<div class="page-hero__content">
				<h1>Blog</h1>
				<p class="lead">{ `Posts, counterarguments, and responses.` }</p>
			</div>
		</section>
		<article>
			<section class="blog-empty">
				<p class="blog-empty__msg">{ `No posts yet.` }</p>
				<p class="blog-empty__sub">{ `Posts, counterarguments, and responses will appear here.` }</p>
			</section>
		</article>
	}
}
