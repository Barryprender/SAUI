package layout

import "strings"

templ Base(title string, csrfToken string, currentPath string, pageCSS string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } — SAUI</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet"/>
			<link rel="icon" type="image/svg+xml" href="/static/img/favicon.svg"/>
			<link rel="stylesheet" href="/static/css/main.css"/>
			<link rel="stylesheet" href="/static/css/htmx.css"/>
			if pageCSS != "" {
				<link rel="stylesheet" href={ pageCSS }/>
			}
			<script
				src="/static/js/htmx.min.js"
				integrity="sha384-HGfztofotfshcF7+8n44JQL2oJmowVChPTg48S+jvZoztPfvwD79OC/LTtG6dMp+"
				crossorigin="anonymous"
				defer
			></script>
			<meta name="htmx-config" content='{"includeIndicatorStyles":false}'/>
			<meta name="csrf-token" content={ csrfToken }/>
		</head>
		<body>
			<a class="skip-link" href="#main-content">{ `Skip to main content` }</a>
			<header>
				<nav aria-label="Main navigation">
					<a href="/"
						aria-label="SAUI"
						if currentPath == "/" {
							aria-current="page"
						}
					>
						<svg class="site-logo" aria-hidden="true" focusable="false"
							width="84" height="26" viewBox="0 0 84 26"
							xmlns="http://www.w3.org/2000/svg">
							<!-- Lock icon background -->
							<rect width="26" height="26" rx="5" fill="var(--c-accent)"/>
							<!-- Lock body -->
							<rect x="3" y="14" width="20" height="10" rx="2.5" fill="oklch(99% 0.004 80)"/>
							<!-- { } bracket shackle -->
							<path d="M 7 14 L 7 11 Q 5.5 10,5.5 9 Q 5.5 8,7 7 L 7 5 Q 7 4,9 4 H 17 Q 19 4,19 5 L 19 7 Q 20.5 8,20.5 9 Q 20.5 10,19 11 L 19 14"
								fill="none" stroke="oklch(99% 0.004 80)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
							<!-- Keyhole -->
							<circle cx="13" cy="19.5" r="2" fill="var(--c-accent)"/>
							<!-- SAUI wordmark -->
							<text x="34" y="18"
								font-family="system-ui,-apple-system,sans-serif"
								font-size="13" font-weight="700"
								letter-spacing="2"
								fill="currentColor">SAUI</text>
						</svg>
					</a>
					<ul>
						<li>
							<a href="/why"
								if currentPath == "/why" {
									aria-current="page"
								}
							>Why</a>
						</li>
						<li>
							<a href="/architecture"
								if currentPath == "/architecture" {
									aria-current="page"
								}
							>Architecture</a>
						</li>
						<li>
							<a href="/stack"
								if currentPath == "/stack" {
									aria-current="page"
								}
							>Stack</a>
						</li>
						<li>
							<a href="/cases"
								if strings.HasPrefix(currentPath, "/cases") {
									aria-current="page"
								}
							>Cases</a>
						</li>
						<li>
							<a href="/testing"
								if currentPath == "/testing" {
									aria-current="page"
								}
							>Testing</a>
						</li>
						<li>
							<a href="/limits"
								if currentPath == "/limits" {
									aria-current="page"
								}
							>Limits</a>
						</li>
						<li>
							<a href="/code"
								if currentPath == "/code" {
									aria-current="page"
								}
							>Code</a>
						</li>
					</ul>
				</nav>
			</header>
			<main id="main-content">
				{ children... }
			</main>
			<footer>
				<p>SAUI — Server-Authoritative UI</p>
			</footer>
			<script type="module" src="/static/js/app.js"></script>
		</body>
	</html>
}
