package layout

import (
	"strings"

	"saui/locale"
)

templ Base(title string, description string, csrfToken string, currentPath string, pageCSS string, lang locale.Lang) {
	<!DOCTYPE html>
	<html lang={ string(lang) }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } — SAUI</title>
			<meta name="description" content={ description }/>
			<meta name="robots" content="index, follow"/>
			<meta name="author" content="SAUI"/>
			<meta
				name="keywords"
				content={ lang.T(
					"server-authoritative UI, SAUI, server-side rendering, htmx, Go, SQLite, web architecture, secure web applications",
					"interfaz autorizada por el servidor, SAUI, renderizado del lado del servidor, htmx, Go, SQLite, arquitectura web, aplicaciones web seguras",
				) }
			/>
			<meta name="theme-color" content="#1a2d4a"/>
			<meta name="application-name" content="SAUI"/>
			<link rel="canonical" href={ "https://saui.fly.dev" + currentPath }/>
			<link rel="alternate" hreflang="en" href={ "https://saui.fly.dev" + lang.BasePath(currentPath) }/>
			<link rel="alternate" hreflang="es" href={ "https://saui.fly.dev/es" + lang.BasePath(currentPath) }/>
			<link rel="alternate" hreflang="x-default" href={ "https://saui.fly.dev" + lang.BasePath(currentPath) }/>
			<meta property="og:type" content="website"/>
			<meta property="og:site_name" content="SAUI"/>
			<meta property="og:title" content={ title + " — SAUI" }/>
			<meta property="og:description" content={ description }/>
			<meta property="og:url" content={ "https://saui.fly.dev" + currentPath }/>
			<meta property="og:locale" content={ lang.OGLocale() }/>
			<meta name="twitter:card" content="summary"/>
			<meta name="twitter:site" content="@saui_dev"/>
			<meta name="twitter:title" content={ title + " — SAUI" }/>
			<meta name="twitter:description" content={ description }/>
			<script type="application/ld+json">
				{"@context":"https://schema.org","@type":"WebSite","name":"SAUI","url":"https://saui.fly.dev","description":"Server-Authoritative UI — a framework for secure, predictable web applications where the server owns all state.","potentialAction":{"@type":"SearchAction","target":"https://saui.fly.dev/search?q={search_term_string}","query-input":"required name=search_term_string"}}
			</script>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=Fraunces:opsz,wght@9..144,700&display=swap" rel="stylesheet"/>
			<link rel="icon" type="image/svg+xml" href="/static/img/favicon.svg"/>
			<link rel="stylesheet" href="/static/css/main.css"/>
			<link rel="stylesheet" href="/static/css/htmx.css"/>
			if pageCSS != "" {
				<link rel="stylesheet" href={ pageCSS }/>
			}
			<script
				src="/static/js/htmx.min.js"
				integrity="sha384-HGfztofotfshcF7+8n44JQL2oJmowVChPTg48S+jvZoztPfvwD79OC/LTtG6dMp+"
				crossorigin="anonymous"
				defer
			></script>
			<meta name="htmx-config" content='{"includeIndicatorStyles":false}'/>
			<meta name="csrf-token" content={ csrfToken }/>
		</head>
		<body>
			<a class="skip-link" href="#main-content">{ lang.T("Skip to main content", "Saltar al contenido principal") }</a>
			<header>
				<nav aria-label={ lang.T("Main navigation", "Navegación principal") }>
					<a
						href={ templ.URL(lang.Prefix() + "/") }
						aria-label="SAUI"
						if currentPath == lang.Prefix()+"/" || currentPath == lang.Prefix() {
							aria-current="page"
						}
					>
						<svg class="site-logo" aria-hidden="true" focusable="false"
							width="64" height="24" viewBox="0 0 64 24"
							xmlns="http://www.w3.org/2000/svg">
							<text class="site-logo__wordmark" x="0" y="19" fill="currentColor">SAUI</text>
						</svg>
					</a>
					<ul>
						<li>
							<a
								href={ templ.URL(lang.Prefix() + "/why") }
								if currentPath == lang.Prefix()+"/why" {
									aria-current="page"
								}
							>{ lang.T("Why", "Por qué") }</a>
						</li>
						<li>
							<a
								href={ templ.URL(lang.Prefix() + "/architecture") }
								if currentPath == lang.Prefix()+"/architecture" {
									aria-current="page"
								}
							>{ lang.T("Architecture", "Arquitectura") }</a>
						</li>
						<li>
							<a
								href={ templ.URL(lang.Prefix() + "/stack") }
								if currentPath == lang.Prefix()+"/stack" {
									aria-current="page"
								}
							>{ lang.T("Stack", "Tecnología") }</a>
						</li>
						<li>
							<a
								href={ templ.URL(lang.Prefix() + "/cases") }
								if strings.HasPrefix(currentPath, lang.Prefix()+"/cases") {
									aria-current="page"
								}
							>{ lang.T("Cases", "Casos") }</a>
						</li>
						<li>
							<a
								href={ templ.URL(lang.Prefix() + "/testing") }
								if currentPath == lang.Prefix()+"/testing" {
									aria-current="page"
								}
							>{ lang.T("Testing", "Pruebas") }</a>
						</li>
						<li>
							<a
								href={ templ.URL(lang.Prefix() + "/limits") }
								if currentPath == lang.Prefix()+"/limits" {
									aria-current="page"
								}
							>{ lang.T("Limits", "Límites") }</a>
						</li>
						<li>
							<a
								href={ templ.URL(lang.Prefix() + "/code") }
								if currentPath == lang.Prefix()+"/code" {
									aria-current="page"
								}
							>{ lang.T("Code", "Código") }</a>
						</li>
						<li>
							<a
								href={ templ.URL(lang.Prefix() + "/blog") }
								if strings.HasPrefix(currentPath, lang.Prefix()+"/blog") {
									aria-current="page"
								}
							>Blog</a>
						</li>
					</ul>
					<a
						class="lang-switch"
						href={ templ.URL(lang.AlternatePath(currentPath)) }
						hreflang={ lang.AlternateHreflang() }
					>{ lang.AlternateLabel() }</a>
					<button class="nav-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label={ lang.T("Open navigation", "Abrir navegación") }>
						<svg width="22" height="14" viewBox="0 0 22 14" aria-hidden="true" focusable="false">
							<line x1="0" y1="2" x2="22" y2="2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
							<line x1="4" y1="12" x2="22" y2="12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
						</svg>
					</button>
				</nav>
			</header>
			<main id="main-content">
				{ children... }
			</main>
			<footer>
				<p>{ lang.T("SAUI: Server-Authoritative UI", "SAUI: Interfaz Autorizada por el Servidor") }</p>
			</footer>
			<dialog id="mobile-nav" class="mobile-nav" aria-label={ lang.T("Navigation", "Navegación") }>
				<div class="mobile-nav__inner">
					<div class="mobile-nav__header">
						<span class="mobile-nav__brand" aria-hidden="true">SAUI</span>
						<button class="mobile-nav__close" aria-label={ lang.T("Close navigation", "Cerrar navegación") }>
							<svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
								<line x1="1" y1="1" x2="17" y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
								<line x1="17" y1="1" x2="1" y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
							</svg>
						</button>
					</div>
					<nav aria-label={ lang.T("Mobile navigation", "Navegación móvil") }>
						<ol class="mobile-nav__list">
							<li>
								<a
									href={ templ.URL(lang.Prefix() + "/why") }
									if currentPath == lang.Prefix()+"/why" {
										aria-current="page"
									}
								>
									<span class="mobile-nav__num" aria-hidden="true">01</span>
									<span class="mobile-nav__label">{ lang.T("Why", "Por qué") }</span>
								</a>
							</li>
							<li>
								<a
									href={ templ.URL(lang.Prefix() + "/architecture") }
									if currentPath == lang.Prefix()+"/architecture" {
										aria-current="page"
									}
								>
									<span class="mobile-nav__num" aria-hidden="true">02</span>
									<span class="mobile-nav__label">{ lang.T("Architecture", "Arquitectura") }</span>
								</a>
							</li>
							<li>
								<a
									href={ templ.URL(lang.Prefix() + "/stack") }
									if currentPath == lang.Prefix()+"/stack" {
										aria-current="page"
									}
								>
									<span class="mobile-nav__num" aria-hidden="true">03</span>
									<span class="mobile-nav__label">{ lang.T("Stack", "Tecnología") }</span>
								</a>
							</li>
							<li>
								<a
									href={ templ.URL(lang.Prefix() + "/cases") }
									if strings.HasPrefix(currentPath, lang.Prefix()+"/cases") {
										aria-current="page"
									}
								>
									<span class="mobile-nav__num" aria-hidden="true">04</span>
									<span class="mobile-nav__label">{ lang.T("Cases", "Casos") }</span>
								</a>
							</li>
							<li>
								<a
									href={ templ.URL(lang.Prefix() + "/testing") }
									if currentPath == lang.Prefix()+"/testing" {
										aria-current="page"
									}
								>
									<span class="mobile-nav__num" aria-hidden="true">05</span>
									<span class="mobile-nav__label">{ lang.T("Testing", "Pruebas") }</span>
								</a>
							</li>
							<li>
								<a
									href={ templ.URL(lang.Prefix() + "/limits") }
									if currentPath == lang.Prefix()+"/limits" {
										aria-current="page"
									}
								>
									<span class="mobile-nav__num" aria-hidden="true">06</span>
									<span class="mobile-nav__label">{ lang.T("Limits", "Límites") }</span>
								</a>
							</li>
							<li>
								<a
									href={ templ.URL(lang.Prefix() + "/code") }
									if currentPath == lang.Prefix()+"/code" {
										aria-current="page"
									}
								>
									<span class="mobile-nav__num" aria-hidden="true">07</span>
									<span class="mobile-nav__label">{ lang.T("Code", "Código") }</span>
								</a>
							</li>
							<li>
								<a
									href={ templ.URL(lang.Prefix() + "/blog") }
									if strings.HasPrefix(currentPath, lang.Prefix()+"/blog") {
										aria-current="page"
									}
								>
									<span class="mobile-nav__num" aria-hidden="true">08</span>
									<span class="mobile-nav__label">Blog</span>
								</a>
							</li>
						</ol>
					</nav>
				</div>
			</dialog>
			<script type="module" src="/static/js/app.js"></script>
		</body>
	</html>
}
