package layout

import "strings"

templ Base(title string, description string, csrfToken string, currentPath string, pageCSS string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } — SAUI</title>
			<meta name="description" content={ description }/>
			<meta name="robots" content="index, follow"/>
			<meta name="author" content="SAUI"/>
			<meta name="keywords" content="server-authoritative UI, SAUI, server-side rendering, htmx, Go, SQLite, web architecture, secure web applications"/>
			<meta name="theme-color" content="#1a2d4a"/>
			<meta name="application-name" content="SAUI"/>
			<link rel="canonical" href={ "https://saui.fly.dev" + currentPath }/>
			<meta property="og:type" content="website"/>
			<meta property="og:site_name" content="SAUI"/>
			<meta property="og:title" content={ title + " — SAUI" }/>
			<meta property="og:description" content={ description }/>
			<meta property="og:url" content={ "https://saui.fly.dev" + currentPath }/>
			<meta property="og:locale" content="en_US"/>
			<meta name="twitter:card" content="summary"/>
			<meta name="twitter:site" content="@saui_dev"/>
			<meta name="twitter:title" content={ title + " — SAUI" }/>
			<meta name="twitter:description" content={ description }/>
			<script type="application/ld+json">
				{"@context":"https://schema.org","@type":"WebSite","name":"SAUI","url":"https://saui.fly.dev","description":"Server-Authoritative UI — a framework for secure, predictable web applications where the server owns all state.","potentialAction":{"@type":"SearchAction","target":"https://saui.fly.dev/search?q={search_term_string}","query-input":"required name=search_term_string"}}
			</script>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=Fraunces:opsz,wght@9..144,700&display=swap" rel="stylesheet"/>
			<link rel="icon" type="image/svg+xml" href="/static/img/favicon.svg"/>
			<link rel="stylesheet" href="/static/css/main.css"/>
			<link rel="stylesheet" href="/static/css/htmx.css"/>
			if pageCSS != "" {
				<link rel="stylesheet" href={ pageCSS }/>
			}
			<script
				src="/static/js/htmx.min.js"
				integrity="sha384-HGfztofotfshcF7+8n44JQL2oJmowVChPTg48S+jvZoztPfvwD79OC/LTtG6dMp+"
				crossorigin="anonymous"
				defer
			></script>
			<meta name="htmx-config" content='{"includeIndicatorStyles":false}'/>
			<meta name="csrf-token" content={ csrfToken }/>
		</head>
		<body>
			<a class="skip-link" href="#main-content">{ `Skip to main content` }</a>
			<header>
				<nav aria-label="Main navigation">
					<a href="/"
						aria-label="SAUI"
						if currentPath == "/" {
							aria-current="page"
						}
					>
						<svg class="site-logo" aria-hidden="true" focusable="false"
							width="64" height="24" viewBox="0 0 64 24"
							xmlns="http://www.w3.org/2000/svg">
							<text class="site-logo__wordmark" x="0" y="19" fill="currentColor">SAUI</text>
						</svg>
					</a>
					<ul>
						<li>
							<a href="/why"
								if currentPath == "/why" {
									aria-current="page"
								}
							>Why</a>
						</li>
						<li>
							<a href="/architecture"
								if currentPath == "/architecture" {
									aria-current="page"
								}
							>Architecture</a>
						</li>
						<li>
							<a href="/stack"
								if currentPath == "/stack" {
									aria-current="page"
								}
							>Stack</a>
						</li>
						<li>
							<a href="/cases"
								if strings.HasPrefix(currentPath, "/cases") {
									aria-current="page"
								}
							>Cases</a>
						</li>
						<li>
							<a href="/testing"
								if currentPath == "/testing" {
									aria-current="page"
								}
							>Testing</a>
						</li>
						<li>
							<a href="/limits"
								if currentPath == "/limits" {
									aria-current="page"
								}
							>Limits</a>
						</li>
						<li>
							<a href="/code"
								if currentPath == "/code" {
									aria-current="page"
								}
							>Code</a>
						</li>
						<li>
							<a href="/blog"
								if strings.HasPrefix(currentPath, "/blog") {
									aria-current="page"
								}
							>Blog</a>
						</li>
					</ul>
					<button class="nav-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open navigation">
						<svg width="22" height="14" viewBox="0 0 22 14" aria-hidden="true" focusable="false">
							<line x1="0" y1="2" x2="22" y2="2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
							<line x1="4" y1="12" x2="22" y2="12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
						</svg>
					</button>
				</nav>
			</header>
			<main id="main-content">
				{ children... }
			</main>
			<footer>
				<p>SAUI — Server-Authoritative UI</p>
			</footer>
			<dialog id="mobile-nav" class="mobile-nav" aria-label="Navigation">
				<div class="mobile-nav__inner">
					<div class="mobile-nav__header">
						<span class="mobile-nav__brand" aria-hidden="true">SAUI</span>
						<button class="mobile-nav__close" aria-label="Close navigation">
							<svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
								<line x1="1" y1="1" x2="17" y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
								<line x1="17" y1="1" x2="1" y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
							</svg>
						</button>
					</div>
					<nav aria-label="Mobile navigation">
						<ol class="mobile-nav__list">
							<li>
								<a href="/why"
									if currentPath == "/why" {
										aria-current="page"
									}
								>
									<span class="mobile-nav__num" aria-hidden="true">01</span>
									<span class="mobile-nav__label">Why</span>
								</a>
							</li>
							<li>
								<a href="/architecture"
									if currentPath == "/architecture" {
										aria-current="page"
									}
								>
									<span class="mobile-nav__num" aria-hidden="true">02</span>
									<span class="mobile-nav__label">Architecture</span>
								</a>
							</li>
							<li>
								<a href="/stack"
									if currentPath == "/stack" {
										aria-current="page"
									}
								>
									<span class="mobile-nav__num" aria-hidden="true">03</span>
									<span class="mobile-nav__label">Stack</span>
								</a>
							</li>
							<li>
								<a href="/cases"
									if strings.HasPrefix(currentPath, "/cases") {
										aria-current="page"
									}
								>
									<span class="mobile-nav__num" aria-hidden="true">04</span>
									<span class="mobile-nav__label">Cases</span>
								</a>
							</li>
							<li>
								<a href="/testing"
									if currentPath == "/testing" {
										aria-current="page"
									}
								>
									<span class="mobile-nav__num" aria-hidden="true">05</span>
									<span class="mobile-nav__label">Testing</span>
								</a>
							</li>
							<li>
								<a href="/limits"
									if currentPath == "/limits" {
										aria-current="page"
									}
								>
									<span class="mobile-nav__num" aria-hidden="true">06</span>
									<span class="mobile-nav__label">Limits</span>
								</a>
							</li>
							<li>
								<a href="/code"
									if currentPath == "/code" {
										aria-current="page"
									}
								>
									<span class="mobile-nav__num" aria-hidden="true">07</span>
									<span class="mobile-nav__label">Code</span>
								</a>
							</li>
							<li>
								<a href="/blog"
									if strings.HasPrefix(currentPath, "/blog") {
										aria-current="page"
									}
								>
									<span class="mobile-nav__num" aria-hidden="true">08</span>
									<span class="mobile-nav__label">Blog</span>
								</a>
							</li>
						</ol>
					</nav>
				</div>
			</dialog>
			<script type="module" src="/static/js/app.js"></script>
		</body>
	</html>
}
