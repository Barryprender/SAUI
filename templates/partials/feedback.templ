package partials

import "strconv"

templ FeedbackForm(csrfToken string, flash string, flashType string, remaining int) {
	<form
		id="feedback-form"
		method="POST"
		action="/feedback"
		hx-post="/feedback"
		hx-target="#feedback-form"
		hx-swap="outerHTML"
	>
		<input type="hidden" name="_csrf" value={ csrfToken }/>
		if flash != "" {
			<p role="alert" class={ "feedback-flash feedback-flash--" + flashType }>{ flash }</p>
		}
		<div class="feedback-field">
			<label for="feedback-msg">Message</label>
			<textarea
				id="feedback-msg"
				name="message"
				rows="5"
				maxlength="2000"
				required
				placeholder={ "Counterarguments, questions, edge cases. " + strconv.Itoa(remaining) + " remaining." }
			></textarea>
		</div>
		<div class="feedback-actions">
			<button type="submit" class="btn">Send</button>
		</div>
	</form>
}

templ FeedbackDone() {
	<div id="feedback-form" class="feedback-done">
		<p>{ `3 messages sent. That is your limit for this session.` }</p>
	</div>
}
