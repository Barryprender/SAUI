package banking

templ Dashboard(account AccountProjection) {
	@Layout("Dashboard") {
		<section class="balance-section" aria-labelledby="balance-heading">
			<div class="balance-card">
				<p class="balance-card__label">Total balance</p>
				<p id="balance-heading" class="balance-card__amount">{ FormatBalance(account.BalanceCents) }</p>
				<p class="balance-card__sub">Demo Account · EUR</p>
			</div>
			<div class="balance-actions">
				<a href="/demo/banking/transfer" class="btn-action">
					<span class="btn-action__icon" aria-hidden="true">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<line x1="12" y1="19" x2="12" y2="5"></line>
							<polyline points="5 12 12 5 19 12"></polyline>
						</svg>
					</span>
					Send
				</a>
			</div>
		</section>
		<section class="tx-section" aria-labelledby="tx-heading">
			<h2 id="tx-heading" class="section-title">Transfers</h2>
			if len(account.Transfers) == 0 {
				<p class="empty-state">No transfers yet.</p>
			} else {
				<ul class="tx-list" role="list">
					for _, tx := range account.Transfers {
						<li class="tx-item">
							<div class={ "avatar " + tx.RecipientColorClass } aria-hidden="true">{ tx.RecipientInitials }</div>
							<div class="tx-item__body">
								<span class="tx-item__name">{ tx.RecipientName }</span>
								<time class="tx-item__time" datetime={ tx.OccurredAt.Format("2006-01-02T15:04:05Z") }>
									{ tx.OccurredAt.Format("Jan 2, 15:04") }
								</time>
							</div>
							<span class="tx-item__amount">-{ FormatBalance(tx.AmountCents) }</span>
						</li>
					}
				</ul>
			}
		</section>
		<details class="saui-note">
			<summary>How does this work?</summary>
			<p>
				Your balance lives on the server as an append-only event log.
				The browser holds no account state.
				Each transfer is a durable, immutable event — the event ID on the confirmation screen is your proof.
				The balance is recomputed server-side on every request; nothing in this page can be tampered with to gain funds.
			</p>
		</details>
	}
}
