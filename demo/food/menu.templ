package food

templ Menu(menu MenuProjection, cart CartProjection, csrfToken string) {
	@Layout("Menu", csrfToken) {
		<nav class="category-nav" aria-label="Menu categories">
			<div class="category-nav__inner">
				<ul role="list">
					for _, cat := range menu.Categories {
						<li>
							<a href={ templ.SafeURL("#cat-" + cat.Name) } class="category-nav__link">{ cat.Name }</a>
						</li>
					}
				</ul>
			</div>
		</nav>
		<div class="menu-layout">
			<section aria-label="Menu">
				for _, cat := range menu.Categories {
					<section
						id={ "cat-" + cat.Name }
						class="menu-category"
						aria-labelledby={ "heading-" + cat.Name }
					>
						<h2 id={ "heading-" + cat.Name } class="menu-category__title">{ cat.Name }</h2>
						<ul class="menu-items" role="list">
							for _, item := range cat.Items {
								<li class="menu-item">
									<div class="menu-item__info">
										<h3 class="menu-item__name">{ item.Name }</h3>
										<p class="menu-item__desc">{ item.Description }</p>
										<span class="menu-item__price">{ formatPrice(item.PriceCents) }</span>
									</div>
									@MenuItemAction(item.ID, item.Name, item.Available, CartItemQty(cart, item.ID), csrfToken)
								</li>
							}
						</ul>
					</section>
				}
			</section>
			@CartPanel(cart, csrfToken, "")
		</div>
		<script>
			(function () {
				const sections = document.querySelectorAll('.menu-category');
				const links = document.querySelectorAll('.category-nav__link');
				if (!sections.length || !links.length) return;
				const obs = new IntersectionObserver(function (entries) {
					entries.forEach(function (e) {
						if (!e.isIntersecting) return;
						const id = e.target.id;
						links.forEach(function (l) {
							l.toggleAttribute('aria-current', l.getAttribute('href') === '#' + id);
						});
					});
				}, { rootMargin: '-30% 0px -60% 0px' });
				sections.forEach(function (s) { obs.observe(s); });
			})();
		</script>
	}
}
