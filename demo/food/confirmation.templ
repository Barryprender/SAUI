package food

import "fmt"

templ Confirmation(order OrderProjection) {
	@Layout("Order Confirmed", "") {
		<article class="confirmation" aria-labelledby="conf-heading">
			<header class="confirmation__header">
				<div class="confirmation__check" aria-hidden="true">✓</div>
				<h2 id="conf-heading" class="confirmation__title">Order placed</h2>
				<p class="confirmation__time">{ order.PlacedAt.Format("15:04") }</p>
			</header>
			<div class="confirmation__receipt">
				<ul class="confirmation__items" role="list">
					for _, item := range order.Items {
						<li class="confirmation__item">
							<span>
								{ item.Name }
								<span class="confirmation__qty">×{ fmt.Sprintf("%d", item.Quantity) }</span>
							</span>
							<span class="confirmation__item-price">{ formatPrice(item.PriceCents * int64(item.Quantity)) }</span>
						</li>
					}
				</ul>
				<div class="confirmation__total">
					<span>Total</span>
					<strong>{ formatPrice(order.TotalCents) }</strong>
				</div>
			</div>
			<div class="confirmation__cta">
				<a href="/demo/food-ordering" class="btn-back">Order again</a>
			</div>
			<p class="confirmation__note">
				This order is a durable event in the server's append-only log.
				It cannot be altered retroactively — not by the client, not by anyone.
			</p>
		</article>
	}
}
